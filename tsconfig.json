{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "laya-web": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "tests/*.ts",
    "examples/minimal/*.ts",
    "vitest.config.ts",
    "tests/browser/*.ts"
  ]
}
