{
  "name": "@r4ai/laya-web",
  "version": "0.1.2",
  "description": "Laya typed decisions in browsers and Node.js with ONNX Runtime Web",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "pnpm build && vite build examples/minimal",
    "dev": "pnpm build && vite examples/minimal --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "model:export": "uv run python scripts/export_model.py --output examples/minimal/public/models/laya",
    "model:verify": "uv run --group reference python scripts/verify_model.py --model examples/minimal/public/models/laya",
    "prepack": "pnpm build",
    "test:browser": "pnpm build && vite tests/browser --host 127.0.0.1 --port 5174",
    "build:pages": "pnpm build:demo && node scripts/validate-pages.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm format",
    "release": "changeset publish",
    "test:node": "pnpm build && node --test tests/node-package.mjs",
    "model:verify:node": "pnpm build && node scripts/verify-node.mjs"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@huggingface/tokenizers": "0.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "0.27.7",
    "jsdom": "^30.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "solid-js": "^1.9.15",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r4ai/laya-web.git"
  },
  "engines": {
    "node": ">=22"
  }
}
